# Line-ending policy, so core.autocrlf differences between machines don't
# cause whole-file diffs.
#
# Note on how this interacts with upstream (mcneel/compute.rhino3d): upstream
# stores CRLF *in the repo*, while `text=auto` below normalizes text to LF in
# the index. `eol=crlf` only controls what lands in the working tree on
# checkout — it does NOT make the committed blob CRLF. So for any file we have
# ever re-staged, our blob differs from upstream's byte-for-byte even when the
# content is identical, and `git diff upstream/8.x` reports the whole file as
# changed. Use `git diff --ignore-all-space` (or compare `tr -d '\r'` hashes)
# when auditing the real fork delta against upstream.

# Default: normalize text to LF in the index on commit.
* text=auto

# Source and text files — check out as CRLF (working tree only).
*.cs        text eol=crlf
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.config    text eol=crlf
*.json      text eol=crlf
*.xml       text eol=crlf
*.md        text eol=crlf
*.txt       text eol=crlf
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.yml       text eol=crlf
*.yaml      text eol=crlf

# Shell scripts must stay LF or they break on *nix.
*.sh        text eol=lf

# Python — LF is conventional even on Windows checkouts.
*.py        text eol=lf

# Binary assets — never touch.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.gh        binary
*.ghx       binary
*.3dm       binary
*.afdesign  binary
*.dll       binary
*.pdb       binary
*.zip       binary
