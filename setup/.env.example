# Copy this file to .env and fill in your values.
# setup/.env is gitignored — safe to keep secrets here. It can be a symlink to
# an .env shared with other tools (selva, Terraform); only the variables
# listed in this file are read, in env-lib.sh, and the rest are ignored.

RHINO_TOKEN=your-token-here

# Optional API key — when set, clients must send it as the RhinoComputeKey
# header (match it with RHINO_COMPUTE_KEY in your app's .env)
# RHINO_COMPUTE_KEY=some-shared-secret

# Live-mounted local plugin build folders (comma-separated absolute paths).
# Rebuild the plugin, then `docker restart rhino-compute-x9` to pick up changes.
# A plugin listed here must NOT also sit in setup/plugins/ — the container
# refuses to start when it finds the same .gha twice.
# LOCAL_PLUGINS=/Users/you/coding/my-plugin/bin/net8.0

# Optional overrides (uncomment to use):
# PORT=6500
# CHILD_COUNT=1

# Resource limits. Rhino.Compute cannot cap cores itself — CHILD_COUNT only
# sets how many compute.geometry workers run, and each is a full headless
# Rhino using many threads. Cap at the container level and keep CHILD_COUNT
# at or below the core count (the launcher warns if it isn't).
# CPUS=4          # CPU-time cap (docker --cpus); fractions allowed
# CPUSET=0-3      # or pin to specific cores instead (docker --cpuset-cpus)
# MEMORY=8g       # RAM cap (docker --memory); also turns swap off for the container
# CACHE_LIMIT_PERCENT=60   # evict cached solve results at this % of MEMORY (compute default 70)
# IDLE_SPAN=300           # children exit after this many seconds without a request (compute default 3600)
# RESTART=unless-stopped   # docker restart policy
#
# Dedicated server (x86-64, nothing else on it): leave CPUS/CPUSET unset, set
# CHILD_COUNT to the solves you expect at once and MEMORY to about 2g per child
# plus 2g. See "Running on a dedicated server" in setup/README.md.
# CHILD_COUNT=6
# MEMORY=14g
# CACHE_LIMIT_PERCENT=60
# IMAGE_NAME=rhino-compute-x9
# CONTAINER_NAME=rhino-compute-x9
# REPO_URL=https://github.com/VektorNode/compute.rhino3d.git
# BRANCH=9.x.selva
# PLATFORM=linux/amd64   # keep amd64 even on Apple Silicon; arm64 Rhino packages lag by months

# ---------------------------------------------------------------------------
# ./deploy-server.sh — deploys to a Linux server over SSH
# ---------------------------------------------------------------------------
# Every variable above applies to the server too, unless SERVER_<NAME> is set:
# SERVER_MEMORY=6g gives the server 6g and leaves local runs on MEMORY.
#
# An ssh destination (user@host or a ~/.ssh/config alias) whose user has passwordless sudo.
# DEPLOY_HOST=deploy@203.0.113.10
# DEPLOY_DIR=compute.rhino3d
# Default: LOCAL_PLUGINS, i.e. the builds your local container runs.
# DEPLOY_PLUGINS=/path/to/MyPlugin/Build/net8.0
# Run before the plugins are staged, so they ship freshly built; a failure aborts the deploy.
# DEPLOY_BUILD=dotnet build /path/to/MyPlugin/MyPlugin.csproj -c Release
# The packages.json to ship instead of setup/packages.json, so servers deployed from one checkout
# can install different Yak packages; relative to this file.
# DEPLOY_PACKAGES=packages.json
# Serve https://<name> with a Let's Encrypt certificate; the name must resolve to the
# server, with ports 80 and 443 open (see "HTTPS" in setup/README.md).
# DEPLOY_TLS_DOMAIN=compute.example.com
# Only these addresses or CIDR ranges get through the HTTPS proxy, e.g. your app servers.
# DEPLOY_ALLOW_IPS=198.51.100.7,203.0.113.0/24
#
# The server is on a network: require the key, and give clients the same value.
# SERVER_RHINO_COMPUTE_KEY=generate-with-openssl-rand-hex-32
# Children exit after 5 minutes without a solve, which stops core-hour billing.
# SERVER_IDLE_SPAN=300
# Size to the machine (see "Running on a dedicated server" in setup/README.md):
# these fit 2 vCPU / 8 GB.
# SERVER_CHILD_COUNT=2
# SERVER_MEMORY=6g
# SERVER_CACHE_LIMIT_PERCENT=60
