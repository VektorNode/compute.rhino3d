# Copy to .env.server (gitignored) for ./deploy-server.sh.
# DEPLOY_* lines stay on your machine; every other line becomes the server's
# setup/.env, so any docker-launch.sh variable works here.

# `terraform output deploy_host` in setup/hetzner
DEPLOY_HOST=deploy@203.0.113.10
# DEPLOY_DIR=compute.rhino3d
# Default: LOCAL_PLUGINS from setup/.env, i.e. the builds your local container runs.
# DEPLOY_PLUGINS=/path/to/MyPlugin/Build/net8.0

RHINO_TOKEN=your-token-here
# The server is on a network: require the key, and give clients the same value.
RHINO_COMPUTE_KEY=generate-with-openssl-rand-hex-32

# Children exit after 5 minutes without a solve, which stops core-hour billing.
IDLE_SPAN=300

# A ccx23 (4 vCPU, 16 GB): two concurrent solves, at least 2g per child plus 2g
# (12g gives the solve caches room and leaves the host 4g), and no CPU cap on a
# machine that runs nothing else (see setup/README.md).
CHILD_COUNT=2
MEMORY=12g
CACHE_LIMIT_PERCENT=60
