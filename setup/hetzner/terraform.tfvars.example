# Copy to terraform.tfvars (gitignored). Every value is optional; the defaults are in main.tf.

# location            = "fsn1"
# server_type         = "ccx23"
# ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Narrow SSH to your own address once you know it:
# ssh_allowed_ips = ["203.0.113.7/32"]

# Only for a client outside the private network (plain HTTP over the internet):
# compute_client_ips = ["198.51.100.20/32"]
