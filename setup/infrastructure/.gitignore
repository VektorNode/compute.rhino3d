# Provider binaries and module cache
.terraform/
.terraform.lock.hcl

# State holds resource secrets in plain text
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Variable files hold tokens and keys; commit an *.example instead
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
